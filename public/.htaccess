# ERP shell assets must never be served stale on Windows XAMPP: git checkout
# can leave the old MMap/Sendfile handle open and Apache returns the old
# bytes with HTTP 200. Disable both for this directory so the bytes on disk
# are always the bytes on the wire (c015631+c3).
<IfModule mod_mmap.c>
    EnableMMAP Off
</IfModule>
<IfModule mod_sendfile.c>
    EnableSendfile Off
</IfModule>

# Shell CSS must revalidate on every navigation during development: without
# this, Firefox keeps the old disk-cache bytes even when ?v= changes via a
# cached HTML view (view:clear not re-baking the hash), which is why the
# Inspector showed align-items:flex-end long after the file contained
# align-items:stretch. Must-revalidate forces a conditional GET.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
